# Single wallet fallback
POLY_PRIVATE_KEY=
POLY_SIGNATURE_TYPE=1
POLY_FUNDER_ADDRESS=

# Optional CLOB API credentials. If all three are set, startup uses them directly.
POLY_CLOB_API_KEY=
POLY_CLOB_API_SECRET=
POLY_CLOB_API_PASSPHRASE=

# Optional multi-wallet JSON. This takes priority over POLY_* when set.
# WALLETS_JSON=[{"id":"wallet1","name":"Main","private_key":"0x...","address":"0x...","signature_type":1}]

POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
DRY_RUN=false

DASHBOARD_PASSWORD=
DASHBOARD_2FA_SECRET=
FLASK_SECRET_KEY=
DASHBOARD_PORT=5000
DASHBOARD_POSITIONS_CACHE_SECONDS=5
DASHBOARD_POSITIONS_FIRST_RESPONSE_TIMEOUT=4.0
DASHBOARD_MARKET_INFO_CACHE_SECONDS=86400
DASHBOARD_MARKET_INFO_MAX_LOOKUPS_PER_REFRESH=10
