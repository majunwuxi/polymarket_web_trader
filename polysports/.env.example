# 仅示例；复制为 .env 后使用独立的 PostgreSQL 账户和数据库。
# 可选买入限额，单位为 pUSD。设为 6 和 1 可启用余额 6%、上限最低按 1 pUSD 计算的规则。
# POLYSPORTS_ORDER_LIMIT_PERCENT=6
# POLYSPORTS_ORDER_LIMIT_FLOOR_USD=1
# POLYSPORTS_MAX_DAILY_USD=100
POLYSPORTS_DATABASE_URL=postgresql+psycopg://polysports:CHANGE_ME@127.0.0.1:5432/polysports
POLYSPORTS_ENVIRONMENT=development
# 通过安全方式生成至少 32 字节的随机密钥；不要使用示例值或提交真实密钥。
POLYSPORTS_AUTH_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
POLYSPORTS_PUBLIC_ORIGIN=https://example.invalid

# 第三方密钥仅保存在本地环境；空值会明确标记同步失败。
POLYSPORTS_API_FOOTBALL_KEY=
POLYSPORTS_BALLDONTLIE_KEY=
# 可配置的只读钱包地址列表（JSON）；不要在此字段放私钥或 API 凭据。
POLYSPORTS_WALLETS=[]
# 钱包配置只保存地址及 credential_ref；私钥、CLOB 与赎回凭据从此本地配置读取。
# 智能钱包赎回可在凭据项提供 relayer_api_key 与 relayer_api_key_address。
# 将真实值放在受限的 .env 或环境中，不要提交到 Git。
POLYSPORTS_WALLET_CREDENTIALS={}
# 智能钱包须配置 Polygon 主网 HTTPS RPC，并验证合约已部署。
POLYSPORTS_POLYGON_RPC_URL=

# 组合交易默认关闭；个人账户满足钱包、余额和授权条件后可显式开启。
POLYSPORTS_COMBO_EXECUTION_ENABLED=false
# 已结算仓位赎回默认关闭；须先完成 Router/Adapter 授权并确认 Builder 或 EOA 出金条件。
POLYSPORTS_REDEEM_EXECUTION_ENABLED=false
