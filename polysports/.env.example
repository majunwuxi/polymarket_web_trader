# 仅示例；复制为 .env 后使用独立的 PostgreSQL 账户和数据库。
POLYSPORTS_DATABASE_URL=postgresql+psycopg://polysports:CHANGE_ME@127.0.0.1:5432/polysports
POLYSPORTS_ENVIRONMENT=development
# 通过安全方式生成至少 32 字节的随机密钥；不要使用示例值或提交真实密钥。
POLYSPORTS_AUTH_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
POLYSPORTS_PUBLIC_ORIGIN=https://example.invalid

# 第三方密钥仅保存在本地环境；空值会明确标记同步失败。
POLYSPORTS_API_FOOTBALL_KEY=
POLYSPORTS_BALLDONTLIE_KEY=
# 可配置的只读钱包地址列表（JSON）；不要在此字段放私钥或 API 凭据。
POLYSPORTS_WALLETS=[]
